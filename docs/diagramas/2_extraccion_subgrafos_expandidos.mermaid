---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	registrar(registrar)
	cargar_imagen(cargar_imagen)
	preparar_revision(preparar_revision)
	revision_humana(revision_humana)
	preparar_confirmacion(preparar_confirmacion)
	configurar_pago(configurar_pago)
	validar_configuracion(validar_configuracion)
	validar_decision(validar_decision)
	guardar(guardar)
	regenerar_excel(regenerar_excel)
	marcar_duplicada(marcar_duplicada)
	marcar_rechazada(marcar_rechazada)
	marcar_error(marcar_error)
	extraer(extraer)
	__end__([<p>__end__</p>]):::last
	__start__ --> registrar;
	cargar_imagen -.-> extraer;
	cargar_imagen -.-> marcar_error;
	configurar_pago --> validar_configuracion;
	extraer -.-> marcar_error;
	extraer -.-> validar_presencia;
	guardar -.-> marcar_duplicada;
	guardar -.-> regenerar_excel;
	preparar_confirmacion --> configurar_pago;
	preparar_revision --> revision_humana;
	registrar --> cargar_imagen;
	revision_humana --> validar_decision;
	validar_veredicto -.-> extraer;
	validar_veredicto -.-> marcar_duplicada;
	validar_veredicto -.-> preparar_confirmacion;
	validar_veredicto -.-> preparar_revision;
	validar_configuracion -.-> configurar_pago;
	validar_configuracion -.-> guardar;
	validar_configuracion -.-> marcar_rechazada;
	validar_decision -.-> marcar_rechazada;
	validar_decision -.-> preparar_confirmacion;
	validar_decision -.-> revision_humana;
	validar_decision -.-> validar_presencia;
	marcar_duplicada --> __end__;
	marcar_error --> __end__;
	marcar_rechazada --> __end__;
	regenerar_excel --> __end__;
	subgraph validar["subgrafo de validación (V01–V11)"]
	validar_presencia(presencia<br/>V01 datos obligatorios presentes<br/>V02 RUT válido)
	validar_fechas(fechas<br/>V03 fecha de emisión válida y no futura<br/>V04 vencimiento no anterior a la emisión)
	validar_montos(montos<br/>V05 neto + exento + IVA + otros = total<br/>V11 impuesto adicional con nombre impreso<br/>V06 IVA cercano al 19%<br/>V07 suma de líneas = neto + exento)
	validar_advertencias(advertencias<br/>V08 cantidad × precio − descuento = total de línea)
	validar_duplicado(duplicado<br/>V10 documento no registrado antes)
	validar_veredicto(veredicto<br/>ok · con hallazgos · duplicada)
	validar_advertencias --> validar_duplicado;
	validar_duplicado --> validar_veredicto;
	validar_fechas --> validar_montos;
	validar_montos --> validar_advertencias;
	validar_presencia --> validar_fechas;
	end
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
