# Copie este archivo como ".env" y complete los valores. El archivo ".env" real no se versiona.
# Desarrollo: ".env" en la raíz del proyecto. Cliente: ".env" en la carpeta de datos (FacturExtract_datos).

# Clave de API del modelo de visión (obligatoria)
ANTHROPIC_API_KEY=

# Opcionales: quite el «#» solo de las líneas que use (una variable con valor vacío podría pisar el valor por defecto).

# Modelo de visión (si no se define, se usa el de la aplicación)
# FACTUREXTRACT_MODEL=

# Seguimiento con LangSmith (solo desarrollo). Con LANGSMITH_TRACING=true se envían trazas.
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=
# LANGSMITH_PROJECT=
